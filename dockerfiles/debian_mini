FROM --platform=linux/386 docker.io/i386/debian:buster

ARG DEBIAN_FRONTEND=noninteractive

# Point APT to the archived mirrors and install dependencies in a single layer
RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" > /etc/apt/sources.list && \
    echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" >> /etc/apt/sources.list && \
    apt-get update && apt-get -y install --no-install-recommends \
    bash coreutils apt-utils gcc \
    python3 vim unzip ruby nodejs \
    fakeroot dbus base whiptail hexedit \
    patch wamerican ucf manpages \
    file luajit make lua5.3 dialog curl \
    less cowsay netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

# Create users, set passwords, and configure the startup hook in .bashrc
RUN useradd -m -s /bin/bash user && \
    echo "user:password" | chpasswd && \
    echo "root:password" | chpasswd && \
    echo "/usr/local/bin/checker.sh &" >> /home/user/.bashrc

# Copy examples and set executable permissions for lua scripts
COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

# Copy the checker script, set execution flag, and ensure /home/user ownership is correct
COPY checker.sh /usr/local/bin/checker.sh
RUN chmod +x /usr/local/bin/checker.sh && \
    chown -R user:user /home/user

# Set working directory and environment variables
WORKDIR /home/user
USER user
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="C.UTF-8"

CMD ["/bin/bash"]